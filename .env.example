# WatchTrading frontend environment variables (copy to .env for local dev)

# Absolute base URL of the backend API. Leave EMPTY in dev to use the Vite dev
# proxy (requests to /api/* are forwarded to http://localhost:5000, avoiding CORS).
# In production, set this to the public origin of the API, e.g. https://api.example.com
VITE_API_BASE_URL=

# Public app name (optional)
VITE_APP_NAME=WatchTrading